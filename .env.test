# Test environment configuration
ENVIRONMENT=testing

# Google Calendar (test values)
GOOGLE_SERVICE_ACCOUNT_JSON=/tmp/test-service-account.json

# OpenWeatherMap (test values)
OPENWEATHERMAP_API_KEY=test-api-key
OPENWEATHERMAP_LAT=40.7128
OPENWEATHERMAP_LON=-74.0060
WEATHER_USE_MOCK=true

# Calendar settings
CALENDAR_USE_MOCK=true

# Family members (test data)
FAMILY_MEMBERS=[{"name":"Test User","key":"test","email":"test@example.com","color":"#FF0000"}]

# Cache settings
REDIS_URL=redis://localhost:6379
WEATHER_CACHE_TTL=600
CALENDAR_CACHE_TTL=120

# Database
DATABASE_URL=sqlite+aiosqlite:///./test.db
